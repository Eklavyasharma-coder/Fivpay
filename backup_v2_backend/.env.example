# FivPay Core Banking Backend Configuration
# Copy this file to .env and adjust variables as needed

# Flask Secrets
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-key-32-chars
PORT=5000

# Database Configuration (MySQL 8.0+)
# Set your MySQL root or dedicated user password here:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=fivpay

# Optional full database URI override (e.g. mysql+pymysql://root:password@localhost:3306/fivpay)
# DATABASE_URL=

# Payment Gateway Adapter Mode (sandbox | live | mock)
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_WEBHOOK_SECRET=
